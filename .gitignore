# ── Python bytecode / caches ──
__pycache__/
*.py[cod]
*$py.class

# ── Test / type / lint caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.hypothesis/

# ── Coverage ──
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Packaging / build artifacts ──
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Virtual environments ──
.venv/
venv/
env/
ENV/

# ── Local runtime data (never commit a store / WAL / backups) ──
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
/data/
backups/

# ── Secrets / local env ──
.env
.env.*
!.env.example

# ── Editor / OS ──
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db



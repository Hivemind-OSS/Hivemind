#!/bin/sh
# Hivemind pre-push guard: keep local-only git notes out of every remote.
#
# refs/notes/* (e.g. refs/notes/ai) carry agent/session annotations, not project
# content, and must never be published. Git note-sync can push them on its own, so
# this guard refuses any push whose destination ref is under refs/notes/. Deleting a
# remote notes ref is still allowed, so an accidental publish can always be undone.
#
# Pre-push receives one line per ref on stdin:
#   <local ref> SP <local oid> SP <remote ref> SP <remote oid>
# A delete carries an all-zero <local oid>; any other oid is real content to publish.
#
# Runs via core.hooksPath=.githooks. Bypassable with `git push --no-verify`.
while read -r local_ref local_oid remote_ref remote_oid; do
	case "$remote_ref" in
		refs/notes/*)
			case "$local_oid" in
				*[!0]*)
					echo "pre-push: refusing to publish $remote_ref — git notes are local-only and must not ship (delete is still allowed)." >&2
					exit 1
					;;
			esac
			;;
	esac
done
exit 0

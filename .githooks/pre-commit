#!/bin/sh
# Hivemind agent-contract version guard (pre-commit).
# Keeps CONTRACT_VERSION monotonic and the keystone bundle-hash golden in sync whenever a commit
# touches the served agent contract. Non-blocking: it bumps + regenerates + git-adds, then exits 0.
#
# Enable once per clone:   git config core.hooksPath .githooks
#
# Runs in the committing shell's environment, so commit from the env where `hive` is importable
# (the golden regeneration imports hive.app.onboard_ref). Prefers `python`, falls back to `python3`
# for macOS where `python` may be absent; if neither resolves it exits 0 rather than block.
root=$(git rev-parse --show-toplevel) || exit 0
py=$(command -v python || command -v python3) || exit 0
[ -n "$py" ] || exit 0
exec "$py" "$root/scripts/contract_version_guard.py"

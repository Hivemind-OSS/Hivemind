# .env — operator/startup config for the hive container (the SINGLE source for these).
# Loaded into the container via compose `env_file`. Every HIVE_* knob has a safe code default
# in hive/app/config.py; set a key here only to override it as deliberate operator policy.

# --- optional operator overrides (uncomment to change; value shown = the code default) ---
# HIVE_STORE__DB_PATH=/data/shared.db
# HIVE_OBS__LOG_LEVEL=20               # logging.INFO
# HIVE_RETENTION__BACKUP_KEEP=30

# --- guarantee knobs (the safety firewall — keep conservative) ---
# their defaults live in config.py (in git); set here only as deliberate operator policy.
# HIVE_RECALL__TAU_SERVE=0.70          # the never-hallucinate absolute-relevance serve floor
# HIVE_AUTONOMY__ENABLED=true          # the memory-lifecycle on/off switch

# --- AGI_MODE (the agent-self-authorization opt-in — LOOSENS a safety gate, default OFF) ---
# when true, the server HONORS approved_by="AGI_OVERRIDE" so an agent may self-authorize the
# human-gated trust actions (hive_write establish / hive_supersede / hive_prune). The override
# write/retire is byte-distinguishable in the durable row (approved_by=AGI_OVERRIDE +
# provenance=agent_reasoned); with it off the sentinel is refused fail-closed. Leave OFF unless
# you deliberately delegate the per-write vouch to the fleet.
# HIVE_AGI__MODE=false

# --- secret floor (the credential-scan substrate gate — default ON) ---
# every memory is scanned for credentials BEFORE it is persisted; the default action is refuse.
# set this false to BYPASS the scan — raw text (including secrets) is then stored unscanned into
# shared memory. This LOOSENS a safety gate (default ON is the safe posture); a disabled floor is
# logged loudly at boot and shown in hive_health. Leave ON unless you deliberately accept the risk.
# HIVE_SECRET_SCAN__ENABLED=true

# --- public tunnel (only needed for `hive up --tunnel`) ---
# NGROK_AUTHTOKEN=2abc...              # from https://dashboard.ngrok.com (kept out of git)
# NGROK_DOMAIN=your-brain.ngrok.app    # your account's free static domain (stable URL)

# .env — operator/startup config for the hive container (the SINGLE source for these).
# Loaded into the container via compose `env_file`. Every HIVE_* knob has a safe code default
# in hive/app/config.py; set a key here only to override it as deliberate operator policy.

# --- persistence (the containerized default — set explicitly as deliberate policy) ---
# The containerized daemon DEFAULTS to /data/shared.db in the hive-data volume (the entrypoint
# injects it when this key is unset), so memory persists across restarts either way; the line
# below just makes the choice explicit. Set HIVE_STORE__DB_PATH=:memory: only for a deliberately
# throwaway EPHEMERAL store (e.g. testing) — ALL captured memory is then LOST on every restart,
# boot logs a loud WARN, and hive_health reports `store_ephemeral`.
HIVE_STORE__DB_PATH=/data/shared.db

# --- optional operator overrides (uncomment to change; value shown = the code default) ---
# HIVE_OBS__LOG_LEVEL=20               # logging.INFO
# HIVE_RETENTION__BACKUP_KEEP=30

# --- guarantee knobs (the safety firewall — keep conservative) ---
# their defaults live in config.py (in git); set here only as deliberate operator policy.
# HIVE_RECALL__TAU_SERVE=0.70          # the never-hallucinate absolute-relevance serve floor
# HIVE_AUTONOMY__ENABLED=true          # the memory-lifecycle on/off switch

# --- secret floor (the credential-scan substrate gate — default ON) ---
# every memory is scanned for credentials BEFORE it is persisted; the default action is refuse.
# set this false to BYPASS the scan — raw text (including secrets) is then stored unscanned into
# shared memory. This LOOSENS a safety gate (default ON is the safe posture); a disabled floor is
# logged loudly at boot and shown in hive_health. Leave ON unless you deliberately accept the risk.
# HIVE_SECRET_SCAN__ENABLED=true

# --- server-side census sync (WHICH repos: the durable registry, not this file) ---
# The daemon always runs; what it feeds comes from the repo REGISTRY in the store —
# `hive repo add <url> --name <slug>` — re-read every tick, so registering needs no restart
# and an empty registry is simply an inert tick. Per registered repo the server keeps a local
# mirror and feeds every push/merge on that repo's canonical line into the change-outcome
# evidence ledger — detect-only, never a trust mutation. The keys below tune the LOOP only.
# HIVE_SYNC__TOKEN=                     # the FLEET-DEFAULT read-only git token, used by any
#                                       # registry row added without --token-env (private
#                                       # remotes). Never logged; it reaches git only as the
#                                       # mirror's remote URL. Unset ⇒ anonymous fetches.
# HIVE_SYNC__INTERVAL_S=60              # poll cadence in seconds (floor 5)
# HIVE_SYNC__WEBHOOK_SECRET=            # arms the tunnel-door webhook nudge — standalone-valid,
#                                       # and ONE nudge wakes the loop for every registered repo
# HIVE_SYNC__MIRROR_DIR=/data/sync/mirror   # mirror location (a rebuildable cache)

# --- public tunnel (only needed for `hive up --tunnel`) ---
# NGROK_AUTHTOKEN=2abc...              # from https://dashboard.ngrok.com (kept out of git)
# NGROK_DOMAIN=your-brain.ngrok.app    # your account's free static domain (stable URL)

# --- transport addresses (needed only when something OTHER than compose fronts the daemon) ---
# Read by the entrypoint, not by config.py: these describe the DEPLOYMENT, not the memory system.
# The defaults below ARE the compose posture — leave every line commented for `hive up`.
#
# The daemon binds two doors and auth is a property of the socket: the loopback door is
# TOKENLESS and the tunnel door is TOKEN-REQUIRED. Under compose the tokenless door is safe
# because the port map publishes it to the host's loopback only (`127.0.0.1:8765:8765`), which
# is why it binds all interfaces INSIDE the container — docker's proxy reaches the container by
# its own IP. Fronting the daemon with anything else (a reverse proxy, a container platform's
# router, an orchestrator) removes that protection, so a deployment MUST then move the tokenless
# door to the container's own loopback and expose ONLY the tunnel door.
# HIVE_HTTP_LOOPBACK_HOST=0.0.0.0      # set to 127.0.0.1 when there is no `127.0.0.1:` port map
# HIVE_HTTP_LOOPBACK_PORT=8765         # the tokenless door
# HIVE_HTTP_TUNNEL_HOST=0.0.0.0        # the token-required door — the only one safe to expose
# HIVE_HTTP_TUNNEL_PORT=8766           # set to the port your router/proxy forwards to
# HIVE_HTTP_MAX_BODY_BYTES=1048576     # request body cap (1 MiB)
#
# The address a REMOTE agent reaches — whatever terminates TLS in front of the tunnel door.
# `hive connect` prints the token-gated registration line for it (it takes precedence over
# NGROK_DOMAIN, which is the same posture in the built-in sidecar's terms).
# HIVE_PUBLIC_URL=https://hive.example.dev

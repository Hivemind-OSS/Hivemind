HIVE_TENANT_ID=acme                  # required (compose fails fast if unset)
# --- public tunnel (only needed for `docker compose --profile tunnel up`) ---
# NGROK_AUTHTOKEN=2abc...            # from https://dashboard.ngrok.com (kept out of git)
# NGROK_DOMAIN=your-brain.ngrok.app  # your account's free static domain (stable URL)
# --- guarantee knobs (compose pins these at layer 3 with safe defaults; uncomment to tighten) ---
# the tuning agent cannot change these from hive.config.toml — only the operator, here.
# HIVE_RECALL__H_FRAC_MAX=0.5        # the never-hallucinate entropy floor
# HIVE_RECALL__EPSILON_EXPLORE=0.1   # guardrail-1: novel-memory exposure ε
# HIVE_UTILITY__ISOLATION_FRAC=0.05  # guardrail-2: held-out evaluation slice
# HIVE_AUTONOMY__ENABLED=true        # the memory-lifecycle on/off switch
